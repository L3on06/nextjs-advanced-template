{
  "$comment": "Golden inputs: literal wizard values stamping the reference app. Keys are setup step ids.",
  "bootstrap": { "appName": "Golden Starter", "nodeMajor": 22 },
  "firebase-project": { "projectId": "golden-starter", "region": "europe-west1" },
  "firebase-auth": { "providers": ["email", "google"] },
  "firebase-admin": { "mode": "emulator" },
  "emulator": { "authPort": 9099, "functionsPort": 5001, "firestorePort": 8080, "storagePort": 9199, "uiPort": 4000, "uiEnabled": true },
  "firestore": { "rulesFile": "firestore.rules", "indexesFile": "firestore.indexes.json" },
  "storage": { "rulesFile": "storage.rules" },
  "functions": { "region": "europe-west1" },
  "app-metadata": { "appName": "Golden Starter", "tagline": "Reference stamp proving the kit", "defaultLocale": "en" },
  "design": { "primaryColor": "#1d4ed8", "radius": "0.75", "darkMode": true },
  "typography": { "fontFamily": "Geist", "monoFamily": "Geist Mono", "baseSize": 16 },
  "icons": { "set": "lucide", "defaultSize": 16, "strokeWidth": 2 },
  "branding": { "brandName": "Golden Starter", "brandColor": "#1d4ed8" },
  "languages": { "locales": ["en", "al"], "primaryLocale": "en" },
  "roles": { "roles": ["viewer", "editor", "admin"] },
  "permissions": {},
  "resources": { "extraCollections": [], "extraFolders": [] },
  "routes": { "extraRoutes": [] },
  "navigation": { "extraNav": [] },
  "redirects": { "postSignIn": "/dashboard", "denyLanding": "/sign-in", "legacyAliases": [] },
  "application-statuses": { "lifecycles": [{ "name": "default", "values": ["draft", "active", "archived"] }] },
  "errors": {},
  "seo": { "baseUrl": "http://localhost:3000" },
  "review": {},
  "generate": { "confirm": true }
}
