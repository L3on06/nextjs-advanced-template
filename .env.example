# Firebase — copy to .env.local and fill in. Never commit real values.
# .env.local is git ignored. Service account JSON is never committed either;
# paste its fields into the FIREBASE_ADMIN_* vars below.

# --- Client SDK (public, NEXT_PUBLIC_ prefix) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Admin SDK (server only, no NEXT_PUBLIC_ prefix) ---
# Leave empty for Emulator Suite runs. Required for deploys.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Emulator Suite (dev only, never production) ---
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
# Optional overrides; defaults match firebase.json ports.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Localization (prefixed routing is the locked default) ---
NEXT_PUBLIC_I18N_PREFIX_LOCALE=true
# NEXT_PUBLIC_I18N_DEFAULT_LOCALE=en
