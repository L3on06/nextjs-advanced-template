// Storage Security Rules — deny by default (Rules version 2).
//
// Same layering as firestore.rules: these rules protect DIRECT CLIENT access
// only. Admin SDK use bypasses them, so server side authorization stays
// required. Generic starter scope only: each user's own folder.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Starter uploads for the signed in user. 10 MB cap keeps the default
    // safe; features raise it per path with a reviewed rule change.
    match /users/{userId}/{filePath=**} {
      allow read, write: if isOwner(userId)
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
